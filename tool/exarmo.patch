         (_, 0) => Some(&[]),
         (true, _) => None,
-        (false, _) => Some(unsafe { std::slice::from_raw_parts(ptr, len) }),
+        (false, _) => Some(unsafe { core::slice::from_raw_parts(ptr, len) }),
